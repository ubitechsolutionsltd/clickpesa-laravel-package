{
    "name": "clickpesa/clickpesa-laravel-sdk",
    "description": "ClickPesa PHP & Laravel SDK for seamless payment collections, disbursements, and webhook handling.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "ClickPesa Community",
            "email": "support@clickpesa.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "guzzlehttp/guzzle": "^7.5",
        "ext-json": "*",
        "ext-hash": "*",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ClickPesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClickPesa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClickPesa\\Laravel\\ClickPesaServiceProvider"
            ],
            "aliases": {
                "ClickPesa": "ClickPesa\\Laravel\\Facades\\ClickPesa"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
